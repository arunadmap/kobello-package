{
  "name": "@kobello/sdk",
  "version": "0.1.0",
  "description": "The API Kobello apps use to talk to the Kobello desktop app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunadmap/kobello-package.git"
  },
  "homepage": "https://github.com/arunadmap/kobello-package#readme",
  "bugs": {
    "url": "https://github.com/arunadmap/kobello-package/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js",
      "default": "./dist/mock.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "shell": [
        "./dist/shell.d.ts"
      ],
      "mock": [
        "./dist/mock.d.ts"
      ],
      "protocol": [
        "./dist/protocol.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kobello",
    "sdk",
    "electron"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
